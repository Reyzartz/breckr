{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Vite compiles; tsc only ever typechecks here.
    "noEmit": true,
    // vite/client declares the CSS module shape, without which importing
    // "brake-ui/theme.css" is a type error.
    "types": ["vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
