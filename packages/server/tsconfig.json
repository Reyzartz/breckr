{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  // Everything, tests included — this is what the editor and `npm run typecheck`
  // use. The build uses tsconfig.build.json, which drops the tests.
  "include": ["src/**/*.ts"]
}
