{
  "name": "@breckr/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Scheduler + API: owns the cron registry, runs browser tasks, serves the dashboard",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -f ../../data/test-monitor.db* && DB_PATH=./data/test-monitor.db node --test --test-concurrency=1 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@breckr/shared": "*",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "node-cron": "^4.6.0",
    "puppeteer-core": "^25.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "pino-pretty": "^13.1.3"
  }
}
