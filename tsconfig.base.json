{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Relative imports are written with their real ".ts" extension, and tsc
    // rewrites them to ".js" on emit.
    //
    // This is what lets one set of sources satisfy both runtimes: Node's native
    // type stripping resolves specifiers literally and will NOT map ".js" to a
    // ".ts" file, so `node --watch src/index.ts` needs the real extension —
    // while the compiled output in dist/ needs ".js". Writing ".js" in source
    // (the usual nodenext convention) would break the dev loop outright.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Keeps `tsc` and Node's native type stripping accepting exactly the same
    // syntax, so `npm run dev` (stripping) can never diverge from the compiled
    // build. Rejects enum/namespace/parameter-properties at typecheck instead
    // of letting them throw ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX at runtime.
    "erasableSyntaxOnly": true,

    // Imports mean exactly what they say — a type-only import is erased, and a
    // value import is emitted. This is what makes the types-only shared package
    // safe: accidentally importing a value from it fails loudly at build.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  }
}
