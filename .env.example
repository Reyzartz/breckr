# --- Browser (CDP) ---------------------------------------------------------
# Any CDP-speaking browser works. Lightpanda is the default; headless Chrome is
# the fallback for sites Lightpanda's partial Web API coverage can't handle.
# Swapping between them is this one line -- no code changes.
#
# Lightpanda serves CDP at a fixed ws:// address. Chrome's browser-level socket
# has a per-launch UUID in its path, so give Chrome its http:// address instead
# and the server resolves the real socket itself via /json/version.
#
# This value is for host-based `make start-server` only. docker-compose.yml
# overrides it for the containerized app (which reaches the browser by
# Compose service name, e.g. ws://lightpanda:9222) -- see DOCKER_BROWSER_WS_ENDPOINT
# below to change which browser the container uses.
BROWSER_WS_ENDPOINT=ws://127.0.0.1:9222
# BROWSER_WS_ENDPOINT=http://127.0.0.1:9223  # chrome: docker compose --profile chrome up -d chrome

# Uncomment to make the *containerized* app use Chrome instead of Lightpanda.
# Requires: docker compose --profile chrome up -d --build
# DOCKER_BROWSER_WS_ENDPOINT=http://chrome:9222

# --- Notifications ---------------------------------------------------------
# Nothing to set here. Notification channels -- Telegram, Discord, Slack, email
# and custom webhooks -- are created in the dashboard and stored in the database,
# so credentials are managed without restarting the server.
#
# Their secrets are encrypted at rest with a key generated on first boot into
# `secret.key` beside the database. Back it up with the database: the .db alone
# cannot be read without it.
# SECRET_KEY_FILE=./data/secret.key

# --- Server ----------------------------------------------------------------
PORT=3000
# For host-based `make start-server` only -- docker-compose.yml overrides this
# to 0.0.0.0 for the containerized app, so it is reachable through Docker's
# port mapping.
HOST=127.0.0.1

# Origin allowed to call the API cross-site. Only matters if you serve the
# dashboard from somewhere other than this server: `make start-client` proxies
# /api through Vite, and the container serves the build from this same origin,
# so both are same-origin already.
CLIENT_ALLOWED_ORIGIN=http://localhost:5173

# Built dashboard to serve. Relative paths resolve against the directory holding
# this .env, so the default works whether you run from the repo root or server/.
# Leave the build missing to run the API on its own.
CLIENT_DIST=./client/dist

# --- Storage ---------------------------------------------------------------
DB_PATH=./data/monitor.db
# Runs older than this are pruned on boot and daily at 04:00.
RUN_RETENTION_DAYS=30

# --- Scheduling ------------------------------------------------------------
# Cron expressions are matched against wall-clock time in this timezone, so
# schedules mean what you intended regardless of the server's locale.
TZ=America/New_York
# Hard ceiling on a single task run; a task may override with timeoutMs.
DEFAULT_TIMEOUT_MS=30000
